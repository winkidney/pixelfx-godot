# ./pfxp index: addons/pixelfx_particles/fx/registry.gd (every built effect, by id) and docs/CATALOG.md.
extends RefCounted

const Build := preload("res://addons/pixelfx_particles/core/build.gd")


func run() -> int:
	var all: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(Build.META))
	var ids := PackedStringArray(all.keys())
	ids.sort()
	var reg := PackedStringArray()
	reg.append("# Generated by ./pfxp index: every built effect, by id. Don't edit; run `./pfxp index` (tools/lib/index.gd).")
	reg.append("extends RefCounted")
	reg.append("")
	reg.append("## id -> { path, name, loop, duration, size, origin, actor, act }")
	reg.append("const EFFECTS := {")
	var md := PackedStringArray()
	var built := 0
	var cat := ""
	var rows := PackedStringArray()
	for id in ids:
		var path := "res://addons/pixelfx_particles/fx/%s.tscn" % id
		if not FileAccess.file_exists(path):
			continue
		built += 1
		var m: Dictionary = all[id]
		reg.append('\t"%s": {"path": "%s", "name": %s, "loop": %s, "duration": %s, "size": [%d, %d], "origin": [%d, %d], "actor": %d, "act": %s},' % [
			id, path, JSON.stringify(m.name), str(m.loop).to_lower(), str(float(m.duration)), m.size[0], m.size[1], m.origin[0], m.origin[1], m.actor, str(m.has("act")).to_lower()])
		var c := id.get_slice("/", 0)
		if c != cat:
			cat = c
			rows.append("\n## %s\n\n| effect | id | | size | what it does |\n|---|---|---|---|---|" % c)
		rows.append("| %s | `%s` | %s %ss | %d×%d | %s |" % [m.name, id, "loop" if m.loop else "one-shot", str(m.duration), m.size[0], m.size[1], m.desc])
	reg.append("}")
	reg.append("")
	var f := FileAccess.open("res://addons/pixelfx_particles/fx/registry.gd", FileAccess.WRITE)
	f.store_string("\n".join(reg))
	f.close()
	md.append("# Catalog\n")
	md.append("%d of %d effects built as particle scenes. Each is `addons/pixelfx_particles/fx/<category>/<name>.tscn`, built from `build/fx/<category>/<name>.gd`; the original is `src/fx/<category>/<name>.js`." % [built, ids.size()])
	md.append_array(rows)
	f = FileAccess.open("res://docs/CATALOG.md", FileAccess.WRITE)
	f.store_string("\n".join(md) + "\n")
	f.close()
	print("%d effects -> addons/pixelfx_particles/fx/registry.gd, docs/CATALOG.md" % built)
	return 0
