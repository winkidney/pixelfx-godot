; Engine configuration file.
; pixelfx particles: the pixelfx effects reimagined with Godot's own particle system.

config_version=5

[application]

config/name="pixelfx particles"
config/description="244 pixel art effects built from Godot's native GPU particles, shaders and nodes."
run/main_scene="res://demo/gallery.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=960
window/size/viewport_height=540

[gui]

theme/default_font_antialiasing=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[editor_plugins]

enabled=PackedStringArray("res://addons/pixelfx_particles/plugin.cfg")

[physics]

common/physics_jitter_fix=0.0
