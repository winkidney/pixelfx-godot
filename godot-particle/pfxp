#!/bin/bash
# pixelfx particles CLI: ./pfxp <command> [args] (./pfxp help). Set GODOT if godot isn't on your PATH.
# render (and compare, which renders first) run Godot under xvfb-run with the Compatibility renderer at a fixed
# 30 fps: GPU particles need a real renderer. Everything else runs headless.
DIR="$(cd "$(dirname "$0")" && pwd)"
GODOT_BIN="${GODOT:-godot}"
# importing writes .godot/: one at a time, however many shells run pfxp at once
import_all() {
	mkdir -p "$DIR/records"
	touch "$DIR/records/.gdignore"   # scratch renders: nothing for Godot to import
	flock "$DIR/records/.import.lock" "$GODOT_BIN" --headless --path "$DIR" --import >/dev/null 2>&1 || true
}
if [ ! -d "$DIR/.godot/imported" ] || [ "$1" = "import" ]; then
	import_all
	[ "$1" = "import" ] && exit 0
fi
# render and smoke need a real renderer: Godot under xvfb-run with the Compatibility renderer, at a fixed frame rate
display() {
	local cmd="$1"
	shift
	local fps=30
	[[ " $* " == *" --act "* ]] && fps=60
	local log
	log=$(mktemp)
	# the Dummy audio driver: effects play their sound, and a render or smoke run of 244 of them stays quiet
	xvfb-run -a -s "-screen 0 1280x800x24" "$GODOT_BIN" --no-header --path "$DIR" --rendering-driver opengl3 --audio-driver Dummy \
		--fixed-fps $fps --disable-vsync --delta-smoothing disable -s res://tools/cli.gd -- "$cmd" "$@" 2>&1 \
		| grep -v -e "Could not set V-Sync" -e "set_use_vsync" -e "^OpenGL API" -e "^$" | tee "$log"
	local code="${PIPESTATUS[0]}"
	# a shader that doesn't compile, or a script error, fails the run even when Godot carries on
	if grep -q -e "SHADER ERROR" -e "SCRIPT ERROR" "$log"; then
		echo "FAIL: shader or script errors above" >&2
		code=1
	fi
	rm -f "$log"
	return "$code"
}
render() {
	display render "$@"
}
case "$1" in
	render)
		shift
		render "$@"
		exit $?
		;;
	smoke)
		shift
		display smoke "$@"
		exit $?
		;;
	perf)
		# runtime cost on the real GPU: a window on the desktop, the Compatibility renderer, no vsync (not Xvfb)
		# (Dummy audio: a crowd of 64 explosions measured, not heard)
		exec "$GODOT_BIN" --no-header --path "$DIR" --rendering-method gl_compatibility --rendering-driver opengl3 \
			--audio-driver Dummy --disable-vsync --resolution 1280x720 -s res://tools/cli.gd -- "$@"
		;;
	sfx)
		# every effect's sound (port/sfx/make.py): render and check the wavs, export the pack (OGG into
		# addons/pixelfx_particles/sfx/, or --out DIR [--format wav|ogg]), then let Godot import it
		shift
		python3 -I "$DIR/port/sfx/make.py" "$@"
		code=$?
		[[ " $* " != *" --out"* ]] && import_all
		exit $code
		;;
	compare)
		shift
		ids=()
		for a in "$@"; do [[ "$a" != --* ]] && ids+=("$a"); done
		extra=()
		[[ " $* " == *" --act "* ]] && extra+=(--act)
		if [[ " $* " != *" --no-render "* ]]; then render "${ids[@]}" "${extra[@]}" --quiet || exit 1; fi
		exec python3 -I "$DIR/port/compare.py" "$@"
		;;
	*)
		exec "$GODOT_BIN" --headless --no-header --path "$DIR" -s res://tools/cli.gd -- "$@"
		;;
esac
