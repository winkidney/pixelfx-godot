# ./pfx index: regenerate addons/pixelfx/fx/registry.gd (every effect, by id) and docs/CATALOG.md from the effect files.
# port-of: tools/index.mjs (upstream)
extends RefCounted

const Px := preload("res://addons/pixelfx/core/px.gd")
const Lib := preload("fxlib.gd")
const Cats := preload("res://addons/pixelfx/fx/categories.gd")


func run() -> int:
	var metas := []
	for id in Lib.allIds():
		var fx := Lib.loadEffect(id)
		if fx.has("error"):
			printerr("skipping ", id, ": ", fx.error)
			continue
		var m: Dictionary = fx.meta.duplicate()
		m.id = id
		m.kind = ["pure", "sim", "factory"][Px.Fx.info(fx.mod).kind]
		m.has_act = Px.Fx.actOf(fx.mod) != null
		metas.append(m)
	var order := {}
	for i in Cats.categories.size():
		order[Cats.categories[i].id] = i
	var rank := func(id: String) -> int: return order.get(id.get_slice("/", 0), 99)
	Px.sort(metas, func(a, b): return float(rank.call(a.id) - rank.call(b.id)) if rank.call(a.id) != rank.call(b.id) else (-1.0 if a.id < b.id else (1.0 if a.id > b.id else 0.0)))
	var reg := PackedStringArray([
		"# Generated by ./pfx index: every effect, by id. Don't edit; run `./pfx index` (godot/tools/lib/index.gd).",
		"extends RefCounted",
		"",
		"const CATEGORIES := preload(\"categories.gd\").categories",
		"",
		"## id -> { path, name, loop, duration, size, origin, actor, act, kind }",
		"const EFFECTS := {",
	])
	for m in metas:
		reg.append("\t\"%s\": {\"path\": \"res://addons/pixelfx/fx/%s.gd\", \"name\": %s, \"loop\": %s, \"duration\": %s, \"size\": %s, \"origin\": %s, \"actor\": %s, \"act\": %s, \"kind\": \"%s\"}," % [
			m.id, m.id, JSON.stringify(m.get("name", "")), str(m.loop).to_lower(), str(float(m.duration)), str(m.size), str(m.origin), str(m.get("actor", 0)), str(m.has_act).to_lower(), m.kind])
	reg.append_array(PackedStringArray([
		"}",
		"",
		"",
		"## Every effect id, in gallery order.",
		"static func ids() -> PackedStringArray:",
		"\treturn PackedStringArray(EFFECTS.keys())",
		"",
		"",
		"## The effect script for an id (\"fire/torch\"), or null.",
		"static func load_effect(id: String) -> Script:",
		"\tvar e: Variant = EFFECTS.get(id)",
		"\treturn load(e.path) if e != null else null",
		"",
	]))
	Lib.save_text("res://addons/pixelfx/fx/registry.gd", "\n".join(reg))
	var md := PackedStringArray(["# Catalog", ""])
	var ncat := 0
	for c in Cats.categories:
		if metas.any(func(m): return m.id.begins_with(c.id + "/")):
			ncat += 1
	md.append("%d effects in %d categories. Every one is a file in `godot/addons/pixelfx/fx/<category>/<name>.gd` (ported from `src/fx/<category>/<name>.js`); render any of them with `./pfx render <id> --gif`." % [metas.size(), ncat])
	md.append("")
	for c in Cats.categories:
		var list := metas.filter(func(m): return m.id.begins_with(c.id + "/"))
		if list.is_empty():
			continue
		md.append_array(PackedStringArray(["## " + c.name, "", c.blurb + ".", "", "| effect | id | | size | what it does |", "|---|---|---|---|---|"]))
		for m in list:
			md.append("| %s | `%s` | %s %ss | %d×%d | %s |" % [m.get("name", ""), m.id, "loop" if m.loop else "one-shot", str(snappedf(m.duration, 0.01)), m.size[0], m.size[1], String(m.get("desc", "")).replace("|", "\\|")])
		md.append("")
	Lib.save_text("res://docs/CATALOG.md", "\n".join(md))
	print("%d effects -> addons/pixelfx/fx/registry.gd, docs/CATALOG.md" % metas.size())
	return 0
