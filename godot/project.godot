; Godot 4.7 project for the pixelfx port: the addon (addons/pixelfx), its tools, tests and demo.

config_version=5

[application]

config/name="pixelfx"
config/description="Code-drawn pixel art effects, ported from github.com/patch-gg/pixelfx."
config/features=PackedStringArray("4.7")
run/main_scene="res://demo/gallery.tscn"

[debug]

gdscript/warnings/directory_rules={"res://addons": 1}
gdscript/warnings/integer_division=2
gdscript/warnings/confusable_capture_reassignment=2
gdscript/warnings/narrowing_conversion=1

[editor_plugins]

enabled=PackedStringArray("res://addons/pixelfx/plugin.cfg")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

textures/canvas_textures/default_texture_filter=0
